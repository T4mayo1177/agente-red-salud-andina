# Copie este archivo como .env (en esta carpeta o en backend/) y ponga su clave de Google AI Studio.
# La lista completa de variables está en backend/.env.example.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_RESPALDO=gemini-3.1-flash-lite
GATEWAY_MODEL=gemma-4-26b-a4b-it
