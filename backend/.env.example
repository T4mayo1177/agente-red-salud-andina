# Copie este archivo como backend/.env (o use el .env de una carpeta superior) y complete la clave.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Agente principal. Vacío = gemini-3.5-flash-lite (~500 solicitudes/día gratis; gemini-3.5-flash solo da 20).
GEMINI_MODEL=
# Razonamiento del agente: MINIMAL, LOW, MEDIUM o HIGH. Vacío = LOW (con menos, a veces no registra las preguntas).
GEMINI_THINKING=
# Si el agente agota su cuota (429), responde este modelo, que tiene cuota propia. Vacío = gemini-3.1-flash-lite.
GEMINI_MODEL_RESPALDO=
# Modelo del gateway. Vacío = gemma-4-26b-a4b-it: cuota distinta de la del agente, ~0,8 s por mensaje.
GATEWAY_MODEL=
STORAGE_BACKEND=jsonl
ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
